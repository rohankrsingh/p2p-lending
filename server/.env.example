# ── Server environment ────────────────────────────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.

# MongoDB connection string (prod: your Atlas URI)
MONGO_URI=mongodb://localhost:27017/p2p

# JSON web token secret — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me

# Port (Vercel injects PORT automatically)
PORT=5000

# CORS origin — frontend dev server or deployed URL
CLIENT_URL=http://localhost:5173

# Stripe (test keys — find them in the Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Endpoint secret from: Stripe Dashboard > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend transactional email
RESEND_API_KEY=re_xxx
# Optional: override the default sender
# RESEND_FROM_EMAIL=p2p-lending <noreply@p2plend.example.com>

# ── Demo / safety flags ──────────────────────────────────────────────
# Set to true to run the deployed-API smoke test (registers a user against prod DB)
# ALLOW_DEPLOYED_TEST=true
